# Copiar a .env y completar. El archivo .env NO se versiona.

# --- Identidad (Entra ID). No son secretos: son identificadores publicos del App Registration ---
# Validan el JWT de GET /api/v1/notify/status y de /actuator/metrics, que exigen el rol Admin.
AZURE_TENANT_ID=055d11d1-8ae0-4221-a6f7-b50be0a623b4
AZURE_CLIENT_ID=704a544f-3d92-44f5-aef9-8559574cff34

# --- RabbitMQ ---
# Ojo con el nombre de la contraseña: application.yml lee RABBITMQ_PASS, mientras que el .env
# compartido de infra usa RABBITMQ_PASSWORD y el compose hace el mapeo entre ambos. Para ejecutar
# este servicio de forma autónoma hay que definir RABBITMQ_PASS, o la conexión sale sin contraseña
# y el broker responde ACCESS_REFUSED.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=andesstay
RABBITMQ_USER=andesstay
RABBITMQ_PASS=cambiar_esto

# --- Politica de reintentos antes de enviar a la DLQ ---
# Backoff exponencial: 1 s, 2 s, 4 s, con techo en NOTIFY_BACKOFF_MAX_MS.
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BACKOFF_MS=1000
NOTIFY_BACKOFF_MAX_MS=10000
# Fair dispatch: un mensaje por consumidor a la vez.
NOTIFY_PREFETCH=1

# --- Politicas de retencion de las colas ---
# TTL del mensaje en la cola de trabajo (5 min) y en la DLQ (24 h), y tope de mensajes por cola.
NOTIFY_MENSAJE_TTL_MS=300000
NOTIFY_DLQ_TTL_MS=86400000
NOTIFY_MAX_LENGTH=1000

# --- Registro de idempotencia en memoria ---
NOTIFY_IDEMPOTENCIA_TTL=PT6H
NOTIFY_IDEMPOTENCIA_CAPACIDAD=50000

# --- Correo saliente ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=AndesStay <noreply@andesstay.cl>
